#!/usr/bin/env python
import argparse
import logging
import sys
from urllib.parse import urlparse

from scm.manager import SourceCodeManager
from scm.private.cli_support import add_commands, execute_command, load_credentials, resolve

logger = logging.getLogger(__name__)


def main():
    creds = load_credentials()

    parser = argparse.ArgumentParser(description="RPC client for Sentry")

    parser.add_argument(
        "--base-url",
        default="http://localhost:8000",
        help="URL where Sentry is accessible",
    )
    parser.add_argument(
        "--secret",
        default=None,
        help=(
            "RPC shared secret (value of Sentry's SCM_RPC_SHARED_SECRET setting)."
            " Defaults to SCM_RPC_SECRET from .credentials"
        ),
    )

    parser.add_argument(
        "--gitlab-base-url",
        default=None,
        help=(
            "Base URL for the GitLab instance. Used only for '--provider gitlab'."
            " Defaults to GITLAB_BASE_URL from .credentials"
        ),
    )

    parser.add_argument("--org-id", type=int, default=1, help="Sentry organization ID owning the repository")
    parser.add_argument(
        "--provider",
        required=True,
        choices=["github", "gitlab"],
        help="Provider name.",
    )
    parser.add_argument(
        "--repo",
        default=None,
        help=(
            "For GitHub: the numeric repository id, found in https://api.github.com/repos/{owner}/{repo}."
            " For GitLab: the numeric project id, found in the top-right '...' menu on the GitLab project page."
            " Defaults to GITLAB_PROJECT_ID or GITHUB_REPOSITORY_ID from .credentials according to the provider"
        ),
    )

    add_commands(parser)

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        sys.exit(1)

    gitlab_base_url = resolve("GITLAB_BASE_URL", args.gitlab_base_url, creds)
    secret = resolve("SCM_RPC_SECRET", args.secret, creds)
    repo_variable_name = "GITLAB_PROJECT_ID" if args.provider == "gitlab" else "GITHUB_REPOSITORY_ID"
    repo = resolve(repo_variable_name, args.repo, creds)

    missing = []
    if not secret:
        missing.append("SCM_RPC_SECRET")
    if not repo:
        missing.append(repo_variable_name)
    if args.provider == "gitlab" and not gitlab_base_url:
        missing.append("GITLAB_BASE_URL")
    if missing:
        logger.error(f"Error: missing required config: {', '.join(missing)}")
        sys.exit(1)

    if args.provider == "gitlab":
        repo = f"{urlparse(gitlab_base_url).netloc}:{repo}"

    scm = SourceCodeManager.make_proxy_client(
        args.org_id,
        (args.provider, repo),
        base_url=args.base_url,
        signing_secret=secret,
    )

    execute_command(args, scm)


if __name__ == "__main__":
    logging.basicConfig(level=logging.DEBUG)
    main()
