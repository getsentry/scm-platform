#!/usr/bin/env python
"""
RPC client that talks to a github-server instance.

Usage:
    bin/github-client --repo owner/repo <command> [args...]

Configuration (CLI args override env vars):
    --base-url / SCM_RPC_BASE_URL       Server URL (default: http://127.0.0.1:8080)
    --secret / SCM_RPC_SIGNING_SECRET   HMAC signing secret (default: "secret")
    --org-id                            Organization ID (default: 1)
    --repo / GITHUB_REPOSITORY_NAME     GitHub repository as owner/repo

Commands:
    get-pull-request <id>
    get-pull-requests [--state open|closed]
    get-pull-request-files <id>
    get-pull-request-commits <id>
    get-pull-request-diff <id>
    get-pull-request-review-threads <id> [--include-reactions]
    get-pull-request-review <pull_request_id> <review_id>
    get-review-comments <pull_request_id> <review_id> [--cursor <n>] [--per-page <n>]
    get-pull-request-url <id>
    mark-pull-request-ready-for-review <id>
    mark-pull-request-as-draft <id>
    get-issue <id>
    create-issue <title> <body> [--assignee <user> ...] [--label <name> ...]
    update-issue <issue_id> [--state open|closed] [--assignee <user> ...] [--label <name> ...]
    get-issue-comments <issue_id>
    get-pull-request-comments <pr_id>
    create-issue-comment <issue_id> <body>
    create-pull-request-comment <pr_id> <body>
    create-review-comment <pr_id> <commit_id> <body> <path> (--head <n> | --base <n>)
        [--start-head <n>] [--start-base <n>]
        (a diff line is identified by its number on the head and/or base side;
         pass --start-* for a multiline range)
    update-review-comment <pr_id> <comment_id> <body>
    get-review-comment-reactions <pr_id> <comment_id> [--cursor <n>] [--per-page <n>]
    create-review-comment-reaction <pr_id> <comment_id> <reaction>
    delete-review-comment-reaction <pr_id> <comment_id> <reaction_id>
    collapse-pull-request-comment <pr_id> <thread_id> <comment_node_id> [--reason OUTDATED]
    update-and-collapse-pull-request-comment <pr_id> <thread_id> <comment_id> <comment_node_id> <body>
        [--reason OUTDATED]
    create-check-run <name> <head_sha>
        [--status pending|running|completed]
        [--conclusion success|failure|cancelled|skipped|timed_out|neutral|action_required|unknown]
        [--external-id <id>]
        [--started-at <iso8601>] [--completed-at <iso8601>]
        [--output-title <title> --output-summary <summary> [--output-text <text>]]
    get-check-run <check_run_id>
    update-check-run <check_run_id>
        [--status ...] [--conclusion ...]
        [--output-title <title> --output-summary <summary> [--output-text <text>]]
    get-branch <name>
    delete-branch <name>
    get-git-ref <ref>
    get-commit <sha>
    get-commit-changes <sha> [--cursor <cursor>] [--per-page <n>]
    get-commit-url <sha>
    get-commits-url <sha> [--file-path <path>] [--since YYYY-MM-DD] [--until YYYY-MM-DD]
    get-directory-contents <path> [--ref <ref>]
    get-file-content <path> --ref <ref>
    get-readme --ref <ref>
    get-pull-request-template --ref <ref>
    get-file-url <path> <sha> [--start-line <n>] [--end-line <n>]
    compare-commits <start_sha> <end_sha>
    create-commit <branch> <parent_sha> <message>
        [--create <filename>=<content> ...]
        [--update <filename>=<content> ...]
        [--delete <filename> ...]
        [--move <old_filename>:<new_filename> ...]
        [--chmod <filename>:<0|1> ...]
        [--force]
        [--create-branch]
        [--author-name <name> --author-email <email>]
    get-repository
    list-repositories
    get-repository-assignees
    list-repository-user-permissions
    get-repository-user-permission <username>
    get-repository-labels
    get-repository-topics
    get-app-installation
    get-authenticated-actor
"""

import argparse
import json
import logging
import pathlib
import sys
from datetime import date

from scm.manager import SourceCodeManager
from scm.types import (
    CheckRunOutput,
    ChmodCommitAction,
    CollapsePullRequestCommentProtocol,
    CommitAuthorParam,
    CompareCommitsProtocol,
    CreateCheckRunProtocol,
    CreateCommitProtocol,
    CreateIssueCommentProtocol,
    CreateIssueProtocol,
    CreatePullRequestCommentProtocol,
    CreateReviewCommentProtocol,
    CreateReviewCommentReactionProtocol,
    DeleteBranchProtocol,
    DeleteCommitAction,
    DeleteReviewCommentReactionProtocol,
    DiffLine,
    DownloadArchiveProtocol,
    DownloadWorkflowJobLogProtocol,
    GetAppInstallationProtocol,
    GetArchiveLinkProtocol,
    GetAuthenticatedActorProtocol,
    GetBranchProtocol,
    GetCheckRunProtocol,
    GetCommitChangesProtocol,
    GetCommitProtocol,
    GetCommitsUrlProtocol,
    GetCommitUrlProtocol,
    GetDirectoryContentsProtocol,
    GetFileContentProtocol,
    GetFileUrlProtocol,
    GetGitRefProtocol,
    GetIssueCommentsProtocol,
    GetIssueProtocol,
    GetPullRequestCommentsProtocol,
    GetPullRequestCommitsProtocol,
    GetPullRequestDiffProtocol,
    GetPullRequestFilesProtocol,
    GetPullRequestProtocol,
    GetPullRequestReviewProtocol,
    GetPullRequestReviewThreadsProtocol,
    GetPullRequestsProtocol,
    GetPullRequestTemplateProtocol,
    GetPullRequestUrlProtocol,
    GetReadmeProtocol,
    GetRepositoryAssigneesProtocol,
    GetRepositoryLabelsProtocol,
    GetRepositoryProtocol,
    GetRepositoryTopicsProtocol,
    GetRepositoryUserPermissionProtocol,
    GetReviewCommentReactionsProtocol,
    GetReviewCommentsProtocol,
    ListCheckRunsForRefProtocol,
    ListCheckRunsInCheckSuiteProtocol,
    ListPullRequestReviewsProtocol,
    ListRepositoriesProtocol,
    ListRepositoryUserPermissionsProtocol,
    ListWorkflowJobsProtocol,
    ListWorkflowRunsProtocol,
    MarkPullRequestDraftStateProtocol,
    MoveCommitAction,
    PaginationParams,
    UpdateAndCollapsePullRequestCommentProtocol,
    UpdateCheckRunProtocol,
    UpdateIssueProtocol,
    UpdateReviewCommentProtocol,
    WriteCommitAction,
)

BUILD_STATUS_CHOICES = ["pending", "running", "completed"]
BUILD_CONCLUSION_CHOICES = [
    "success",
    "failure",
    "cancelled",
    "skipped",
    "timed_out",
    "neutral",
    "action_required",
    "unknown",
]
REACTION_CHOICES = ["+1", "-1", "laugh", "confused", "heart", "hooray", "rocket", "eyes"]


def build_check_run_output(args: argparse.Namespace) -> CheckRunOutput | None:
    if args.output_title is None and args.output_summary is None and args.output_text is None:
        return None
    if args.output_title is None or args.output_summary is None:
        raise SystemExit("--output-title and --output-summary are both required when setting an output.")
    output: CheckRunOutput = {"title": args.output_title, "summary": args.output_summary}
    if args.output_text is not None:
        output["text"] = args.output_text
    return output


def add_check_run_output_args(p: argparse.ArgumentParser) -> None:
    p.add_argument("--output-title", default=None)
    p.add_argument("--output-summary", default=None)
    p.add_argument("--output-text", default=None)


logger = logging.getLogger(__name__)


def dump(obj: object) -> None:
    logger.info(json.dumps(obj, indent=2, default=str))


def _diff_line(base: int | None, head: int | None) -> DiffLine | None:
    """Build a DiffLine from optional base/head args, omitting unset sides."""
    line: DiffLine = {}
    if base is not None:
        line["base"] = base
    if head is not None:
        line["head"] = head
    return line or None


def load_credentials() -> dict[str, str]:
    """Load KEY=VALUE pairs from .credentials, skipping blanks and comments."""
    creds: dict[str, str] = {}
    path = pathlib.Path(__file__).resolve().parent.parent / ".credentials"
    if not path.exists():
        return creds
    for line in path.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        value = value.strip()
        if value:
            creds[key.strip()] = value
    return creds


def main() -> None:
    creds = load_credentials()

    parser = argparse.ArgumentParser(description="GitHub RPC Client")
    parser.add_argument("--base-url", default=None)
    parser.add_argument("--secret", default=None)
    parser.add_argument("--org-id", type=int, default=1)
    parser.add_argument(
        "--repo",
        default=creds.get("GITHUB_REPOSITORY_NAME"),
        required="GITHUB_REPOSITORY_NAME" not in creds,
        help="owner/repo; defaults to GITHUB_REPOSITORY_NAME from .credentials",
    )

    sub = parser.add_subparsers(dest="command")

    p = sub.add_parser("get-pull-request")
    p.add_argument("id")

    p = sub.add_parser("get-pull-requests")
    p.add_argument("--state", default="open", choices=["open", "closed"])

    p = sub.add_parser("get-pull-request-files")
    p.add_argument("id")

    p = sub.add_parser("get-pull-request-commits")
    p.add_argument("id")

    p = sub.add_parser("get-pull-request-diff")
    p.add_argument("id")

    p = sub.add_parser("get-pull-request-review-threads")
    p.add_argument("id")
    p.add_argument(
        "--include-reactions",
        action="store_true",
        help="Fetch reactions on each review thread comment (extra GraphQL cost)",
    )

    p = sub.add_parser("get-pull-request-review")
    p.add_argument("pull_request_id")
    p.add_argument("review_id")

    p = sub.add_parser("get-review-comments")
    p.add_argument("pull_request_id")
    p.add_argument("review_id")
    p.add_argument("--cursor", type=int, default=None)
    p.add_argument("--per-page", type=int, default=None)

    p = sub.add_parser("get-pull-request-url")
    p.add_argument("id")

    p = sub.add_parser("mark-pull-request-ready-for-review")
    p.add_argument("id")

    p = sub.add_parser("mark-pull-request-as-draft")
    p.add_argument("id")

    p = sub.add_parser("get-issue")
    p.add_argument("id")

    p = sub.add_parser("create-issue")
    p.add_argument("title")
    p.add_argument("body")
    p.add_argument("--assignee", action="append", dest="assignees", default=None)
    p.add_argument("--label", action="append", dest="labels", default=None)

    p = sub.add_parser("update-issue")
    p.add_argument("issue_id")
    p.add_argument("--state", choices=["open", "closed"], default=None)
    p.add_argument("--assignee", action="append", dest="assignees", default=None)
    p.add_argument("--label", action="append", dest="labels", default=None)

    p = sub.add_parser("get-issue-comments")
    p.add_argument("issue_id")

    p = sub.add_parser("get-pull-request-comments")
    p.add_argument("pr_id")

    p = sub.add_parser("create-issue-comment")
    p.add_argument("issue_id")
    p.add_argument("body")

    p = sub.add_parser("create-pull-request-comment")
    p.add_argument("pr_id")
    p.add_argument("body")

    p = sub.add_parser("create-review-comment")
    p.add_argument("pr_id")
    p.add_argument("commit_id")
    p.add_argument("body")
    p.add_argument("path")
    p.add_argument("--head", dest="head", type=int, default=None, help="line number on the head side")
    p.add_argument("--base", dest="base", type=int, default=None, help="line number on the base side")
    p.add_argument("--start-head", dest="start_head", type=int, default=None)
    p.add_argument("--start-base", dest="start_base", type=int, default=None)

    p = sub.add_parser("update-review-comment")
    p.add_argument("pr_id")
    p.add_argument("comment_id")
    p.add_argument("body")

    p = sub.add_parser("get-review-comment-reactions")
    p.add_argument("pr_id")
    p.add_argument("comment_id")
    p.add_argument("--cursor", type=int, default=None)
    p.add_argument("--per-page", type=int, default=None)

    p = sub.add_parser("create-review-comment-reaction")
    p.add_argument("pr_id")
    p.add_argument("comment_id")
    p.add_argument("reaction", choices=REACTION_CHOICES)

    p = sub.add_parser("delete-review-comment-reaction")
    p.add_argument("pr_id")
    p.add_argument("comment_id")
    p.add_argument("reaction_id")

    p = sub.add_parser("collapse-pull-request-comment")
    p.add_argument("pr_id")
    p.add_argument("thread_id", help="review thread id (e.g. PRRT_...)")
    p.add_argument("comment_node_id", help="GraphQL comment node id (e.g. PRRC_...)")
    p.add_argument("--reason", default="OUTDATED")

    p = sub.add_parser("update-and-collapse-pull-request-comment")
    p.add_argument("pr_id")
    p.add_argument("thread_id", help="review thread id (e.g. PRRT_...)")
    p.add_argument("comment_id", help="REST review comment id")
    p.add_argument("comment_node_id", help="GraphQL comment node id (e.g. PRRC_...)")
    p.add_argument("body")
    p.add_argument("--reason", default="OUTDATED")

    p = sub.add_parser("create-check-run")
    p.add_argument("name")
    p.add_argument("head_sha")
    p.add_argument("--status", choices=BUILD_STATUS_CHOICES, default=None)
    p.add_argument("--conclusion", choices=BUILD_CONCLUSION_CHOICES, default=None)
    p.add_argument("--external-id", default=None)
    p.add_argument("--started-at", default=None)
    p.add_argument("--completed-at", default=None)
    add_check_run_output_args(p)

    p = sub.add_parser("get-check-run")
    p.add_argument("check_run_id")

    p = sub.add_parser("update-check-run")
    p.add_argument("check_run_id")
    p.add_argument("--status", choices=BUILD_STATUS_CHOICES, default=None)
    p.add_argument("--conclusion", choices=BUILD_CONCLUSION_CHOICES, default=None)
    add_check_run_output_args(p)

    p = sub.add_parser("list-check-runs-in-check-suite")
    p.add_argument("check_suite_id")
    p.add_argument("--check-name", default=None)
    p.add_argument("--status", choices=["queued", "in_progress", "completed"], default=None)
    p.add_argument("--filter", choices=["latest", "all"], default=None)
    p.add_argument("--cursor", type=int, default=None)
    p.add_argument("--per-page", type=int, default=None)

    p = sub.add_parser("list-check-runs-for-ref")
    p.add_argument("ref")
    p.add_argument("--check-name", default=None)
    p.add_argument("--status", choices=["queued", "in_progress", "completed"], default=None)
    p.add_argument("--filter", choices=["latest", "all"], default=None)
    p.add_argument("--cursor", type=int, default=None)
    p.add_argument("--per-page", type=int, default=None)

    p = sub.add_parser("list-workflow-runs")
    p.add_argument("head_sha")
    p.add_argument("--cursor", type=int, default=None)
    p.add_argument("--per-page", type=int, default=None)

    p = sub.add_parser("list-workflow-jobs")
    p.add_argument("workflow_run_id")
    p.add_argument("--cursor", type=int, default=None)
    p.add_argument("--per-page", type=int, default=None)

    p = sub.add_parser("download-workflow-job-log")
    p.add_argument("job_id")

    p = sub.add_parser("list-pull-request-reviews")
    p.add_argument("pull_number")
    p.add_argument("--cursor", type=int, default=None)
    p.add_argument("--per-page", type=int, default=None)

    p = sub.add_parser("get-branch")
    p.add_argument("name")

    p = sub.add_parser("delete-branch")
    p.add_argument("name")

    p = sub.add_parser("get-git-ref")
    p.add_argument("ref", help="e.g. heads/main or tags/v1.0.0")

    p = sub.add_parser("download-archive")
    p.add_argument("ref")

    p = sub.add_parser("get-archive-link")
    p.add_argument("ref")

    p = sub.add_parser("get-commit")
    p.add_argument("sha")

    p = sub.add_parser("get-commit-changes")
    p.add_argument("sha")
    p.add_argument("--cursor", default=None)
    p.add_argument("--per-page", type=int, default=None)

    p = sub.add_parser("get-commit-url")
    p.add_argument("sha")

    p = sub.add_parser("get-commits-url")
    p.add_argument("sha")
    p.add_argument("--file-path", default=None)
    p.add_argument("--since", type=date.fromisoformat, default=None)
    p.add_argument("--until", type=date.fromisoformat, default=None)

    p = sub.add_parser("get-file-content")
    p.add_argument("path")
    p.add_argument("--ref", required=True)

    p = sub.add_parser("get-directory-contents")
    p.add_argument("path")
    p.add_argument("--ref", default=None)

    p = sub.add_parser("get-readme")
    p.add_argument("--ref", required=True)

    p = sub.add_parser("get-pull-request-template")
    p.add_argument("--ref", required=True)

    p = sub.add_parser("get-file-url")
    p.add_argument("path")
    p.add_argument("sha")
    p.add_argument("--start-line", type=int, default=None)
    p.add_argument("--end-line", type=int, default=None)

    p = sub.add_parser("compare-commits")
    p.add_argument("start_sha")
    p.add_argument("end_sha")

    p = sub.add_parser("create-commit")
    p.add_argument("branch")
    p.add_argument("parent_sha")
    p.add_argument("message")
    p.add_argument("--create", action="append", dest="creates", default=None, metavar="FILENAME=CONTENT")
    p.add_argument("--update", action="append", dest="updates", default=None, metavar="FILENAME=CONTENT")
    p.add_argument("--delete", action="append", dest="deletes", default=None, metavar="FILENAME")
    p.add_argument("--move", action="append", dest="moves", default=None, metavar="OLD:NEW")
    p.add_argument("--chmod", action="append", dest="chmods", default=None, metavar="FILENAME:0|1")
    p.add_argument("--force", action="store_true")
    p.add_argument("--create-branch", action="store_true", dest="create_branch")
    p.add_argument("--author-name", dest="author_name", default=None)
    p.add_argument("--author-email", dest="author_email", default=None)

    sub.add_parser("get-repository")
    sub.add_parser("list-repositories")
    sub.add_parser("get-repository-assignees")
    sub.add_parser("list-repository-user-permissions")
    p = sub.add_parser("get-repository-user-permission")
    p.add_argument("username")
    sub.add_parser("get-repository-labels")
    sub.add_parser("get-repository-topics")
    sub.add_parser("get-app-installation")
    sub.add_parser("get-authenticated-actor")

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        sys.exit(1)

    scm = SourceCodeManager.make_proxy_client(
        args.org_id,
        ("github", args.repo),
        base_url=args.base_url if args.base_url else "http://127.0.0.1:8080",
        signing_secret=args.secret if args.secret else "secret",
    )

    if args.command == "get-pull-request":
        assert isinstance(scm, GetPullRequestProtocol)
        dump(scm.get_pull_request(args.id))

    elif args.command == "get-pull-requests":
        assert isinstance(scm, GetPullRequestsProtocol)
        dump(scm.get_pull_requests(state=args.state))

    elif args.command == "get-pull-request-files":
        assert isinstance(scm, GetPullRequestFilesProtocol)
        dump(scm.get_pull_request_files(args.id))

    elif args.command == "get-pull-request-commits":
        assert isinstance(scm, GetPullRequestCommitsProtocol)
        dump(scm.get_pull_request_commits(args.id))

    elif args.command == "get-pull-request-diff":
        assert isinstance(scm, GetPullRequestDiffProtocol)
        dump(scm.get_pull_request_diff(args.id))

    elif args.command == "get-pull-request-review-threads":
        assert isinstance(scm, GetPullRequestReviewThreadsProtocol)
        dump(
            scm.get_pull_request_review_threads(
                args.id,
                include_reactions=args.include_reactions,
            )
        )

    elif args.command == "get-pull-request-review":
        assert isinstance(scm, GetPullRequestReviewProtocol)
        dump(scm.get_pull_request_review(args.pull_request_id, args.review_id))

    elif args.command == "get-review-comments":
        assert isinstance(scm, GetReviewCommentsProtocol)
        pagination: PaginationParams = {}
        if args.cursor is not None:
            pagination["cursor"] = args.cursor
        if args.per_page is not None:
            pagination["per_page"] = args.per_page
        dump(scm.get_review_comments(args.pull_request_id, args.review_id, pagination=pagination or None))

    elif args.command == "get-pull-request-url":
        assert isinstance(scm, GetPullRequestUrlProtocol)
        dump(scm.get_pull_request_url(args.id))

    elif args.command == "mark-pull-request-ready-for-review":
        assert isinstance(scm, MarkPullRequestDraftStateProtocol)
        dump(scm.mark_pull_request_ready_for_review(args.id))

    elif args.command == "mark-pull-request-as-draft":
        assert isinstance(scm, MarkPullRequestDraftStateProtocol)
        dump(scm.mark_pull_request_as_draft(args.id))

    elif args.command == "get-issue":
        assert isinstance(scm, GetIssueProtocol)
        dump(scm.get_issue(args.id))

    elif args.command == "create-issue":
        assert isinstance(scm, CreateIssueProtocol)
        dump(scm.create_issue(args.title, args.body, assignees=args.assignees, labels=args.labels))

    elif args.command == "update-issue":
        assert isinstance(scm, UpdateIssueProtocol)
        dump(scm.update_issue(args.issue_id, state=args.state, assignees=args.assignees, labels=args.labels))

    elif args.command == "get-issue-comments":
        assert isinstance(scm, GetIssueCommentsProtocol)
        dump(scm.get_issue_comments(args.issue_id))

    elif args.command == "get-pull-request-comments":
        assert isinstance(scm, GetPullRequestCommentsProtocol)
        dump(scm.get_pull_request_comments(args.pr_id))

    elif args.command == "create-issue-comment":
        assert isinstance(scm, CreateIssueCommentProtocol)
        dump(scm.create_issue_comment(args.issue_id, args.body))

    elif args.command == "create-pull-request-comment":
        assert isinstance(scm, CreatePullRequestCommentProtocol)
        dump(scm.create_pull_request_comment(args.pr_id, args.body))

    elif args.command == "create-review-comment":
        assert isinstance(scm, CreateReviewCommentProtocol)
        line = _diff_line(args.base, args.head)
        assert line is not None, "pass --base and/or --head for the commented line"
        dump(
            scm.create_review_comment(
                args.pr_id,
                args.commit_id,
                args.body,
                args.path,
                line,
                _diff_line(args.start_base, args.start_head),
            )
        )

    elif args.command == "update-review-comment":
        assert isinstance(scm, UpdateReviewCommentProtocol)
        dump(scm.update_review_comment(args.pr_id, args.comment_id, args.body))

    elif args.command == "get-review-comment-reactions":
        assert isinstance(scm, GetReviewCommentReactionsProtocol)
        pagination = {}
        if args.cursor is not None:
            pagination["cursor"] = args.cursor
        if args.per_page is not None:
            pagination["per_page"] = args.per_page
        dump(scm.get_review_comment_reactions(args.pr_id, args.comment_id, pagination=pagination or None))

    elif args.command == "create-review-comment-reaction":
        assert isinstance(scm, CreateReviewCommentReactionProtocol)
        dump(scm.create_review_comment_reaction(args.pr_id, args.comment_id, args.reaction))

    elif args.command == "delete-review-comment-reaction":
        assert isinstance(scm, DeleteReviewCommentReactionProtocol)
        scm.delete_review_comment_reaction(args.pr_id, args.comment_id, args.reaction_id)

    elif args.command == "collapse-pull-request-comment":
        assert isinstance(scm, CollapsePullRequestCommentProtocol)
        scm.collapse_pull_request_comment(args.pr_id, args.thread_id, args.comment_node_id, args.reason)

    elif args.command == "update-and-collapse-pull-request-comment":
        assert isinstance(scm, UpdateAndCollapsePullRequestCommentProtocol)
        dump(
            scm.update_and_collapse_pull_request_comment(
                args.pr_id,
                args.thread_id,
                args.comment_id,
                args.comment_node_id,
                args.body,
                args.reason,
            )
        )

    elif args.command == "create-check-run":
        assert isinstance(scm, CreateCheckRunProtocol)
        dump(
            scm.create_check_run(
                args.name,
                args.head_sha,
                status=args.status,
                conclusion=args.conclusion,
                external_id=args.external_id,
                started_at=args.started_at,
                completed_at=args.completed_at,
                output=build_check_run_output(args),
            )
        )

    elif args.command == "get-check-run":
        assert isinstance(scm, GetCheckRunProtocol)
        dump(scm.get_check_run(args.check_run_id))

    elif args.command == "update-check-run":
        assert isinstance(scm, UpdateCheckRunProtocol)
        dump(
            scm.update_check_run(
                args.check_run_id,
                status=args.status,
                conclusion=args.conclusion,
                output=build_check_run_output(args),
            )
        )

    elif args.command == "list-check-runs-in-check-suite":
        assert isinstance(scm, ListCheckRunsInCheckSuiteProtocol)
        pagination = PaginationParams()
        if args.cursor is not None:
            pagination["cursor"] = args.cursor
        if args.per_page is not None:
            pagination["per_page"] = args.per_page
        dump(
            scm.list_check_runs_in_check_suite(
                args.check_suite_id,
                check_name=args.check_name,
                status=args.status,
                timestamp_filter=args.filter,
                pagination=pagination or None,
            )
        )

    elif args.command == "list-check-runs-for-ref":
        assert isinstance(scm, ListCheckRunsForRefProtocol)
        pagination: PaginationParams = {}
        if args.cursor is not None:
            pagination["cursor"] = args.cursor
        if args.per_page is not None:
            pagination["per_page"] = args.per_page
        dump(
            scm.list_check_runs_for_ref(
                args.ref,
                check_name=args.check_name,
                status=args.status,
                timestamp_filter=args.filter,
                pagination=pagination or None,
            )
        )

    elif args.command == "list-workflow-runs":
        assert isinstance(scm, ListWorkflowRunsProtocol)
        pagination: PaginationParams = {}
        if args.cursor is not None:
            pagination["cursor"] = args.cursor
        if args.per_page is not None:
            pagination["per_page"] = args.per_page
        dump(
            scm.list_workflow_runs(
                args.head_sha,
                pagination=pagination or None,
            )
        )

    elif args.command == "list-workflow-jobs":
        assert isinstance(scm, ListWorkflowJobsProtocol)
        pagination: PaginationParams = {}
        if args.cursor is not None:
            pagination["cursor"] = args.cursor
        if args.per_page is not None:
            pagination["per_page"] = args.per_page
        dump(
            scm.list_workflow_jobs(
                args.workflow_run_id,
                pagination=pagination or None,
            )
        )

    elif args.command == "download-workflow-job-log":
        assert isinstance(scm, DownloadWorkflowJobLogProtocol)
        logger.info(scm.download_workflow_job_log(args.job_id).text)

    elif args.command == "list-pull-request-reviews":
        assert isinstance(scm, ListPullRequestReviewsProtocol)
        pagination: PaginationParams = {}
        if args.cursor is not None:
            pagination["cursor"] = args.cursor
        if args.per_page is not None:
            pagination["per_page"] = args.per_page
        dump(
            scm.list_pull_request_reviews(
                args.pull_number,
                pagination=pagination or None,
            )
        )

    elif args.command == "get-branch":
        assert isinstance(scm, GetBranchProtocol)
        dump(scm.get_branch(args.name))

    elif args.command == "delete-branch":
        assert isinstance(scm, DeleteBranchProtocol)
        scm.delete_branch(args.name)

    elif args.command == "get-git-ref":
        assert isinstance(scm, GetGitRefProtocol)
        dump(scm.get_git_ref(args.ref))

    elif args.command == "get-commit":
        assert isinstance(scm, GetCommitProtocol)
        dump(scm.get_commit(args.sha))

    elif args.command == "get-commit-changes":
        assert isinstance(scm, GetCommitChangesProtocol)
        pagination = PaginationParams()
        if args.cursor is not None:
            pagination["cursor"] = args.cursor
        if args.per_page is not None:
            pagination["per_page"] = args.per_page
        dump(scm.get_commit_changes(args.sha, pagination=pagination or None))

    elif args.command == "get-commit-url":
        assert isinstance(scm, GetCommitUrlProtocol)
        dump(scm.get_commit_url(args.sha))

    elif args.command == "get-commits-url":
        assert isinstance(scm, GetCommitsUrlProtocol)
        dump(scm.get_commits_url(args.sha, file_path=args.file_path, since=args.since, until=args.until))

    elif args.command == "get-file-content":
        assert isinstance(scm, GetFileContentProtocol)
        dump(scm.get_file_content(args.path, ref=args.ref))

    elif args.command == "get-directory-contents":
        assert isinstance(scm, GetDirectoryContentsProtocol)
        dump(scm.get_directory_contents(args.path, ref=args.ref))

    elif args.command == "get-readme":
        assert isinstance(scm, GetReadmeProtocol)
        dump(scm.get_readme(ref=args.ref))

    elif args.command == "get-pull-request-template":
        assert isinstance(scm, GetPullRequestTemplateProtocol)
        dump(list(scm.get_pull_request_template(ref=args.ref)))

    elif args.command == "get-file-url":
        assert isinstance(scm, GetFileUrlProtocol)
        dump(scm.get_file_url(args.path, args.sha, start_line=args.start_line, end_line=args.end_line))

    elif args.command == "compare-commits":
        assert isinstance(scm, CompareCommitsProtocol)
        dump(scm.compare_commits(args.start_sha, args.end_sha))

    elif args.command == "create-commit":
        assert isinstance(scm, CreateCommitProtocol)
        actions: list = []
        for spec in args.creates or []:
            filename, _, content = spec.partition("=")
            actions.append(WriteCommitAction(action="create", filename=filename, content=content, encoding="utf-8"))
        for spec in args.updates or []:
            filename, _, content = spec.partition("=")
            actions.append(WriteCommitAction(action="update", filename=filename, content=content, encoding="utf-8"))
        for filename in args.deletes or []:
            actions.append(DeleteCommitAction(filename=filename))
        for spec in args.moves or []:
            old, _, new = spec.partition(":")
            actions.append(MoveCommitAction(old_filename=old, new_filename=new))
        for spec in args.chmods or []:
            filename, _, flag = spec.rpartition(":")
            actions.append(ChmodCommitAction(filename=filename, executable=flag == "1"))
        author = None
        if args.author_name or args.author_email:
            if not (args.author_name and args.author_email):
                parser.error("--author-name and --author-email must be used together")
            author = CommitAuthorParam(name=args.author_name, email=args.author_email)
        dump(
            scm.create_commit(
                args.branch,
                args.parent_sha,
                args.message,
                actions,
                force=args.force,
                create_branch=args.create_branch,
                author=author,
            )
        )

    elif args.command == "download-archive":
        assert isinstance(scm, DownloadArchiveProtocol)
        logger.info(scm.download_archive(args.ref))

    elif args.command == "get-archive-link":
        assert isinstance(scm, GetArchiveLinkProtocol)
        dump(scm.get_archive_link(args.ref))

    elif args.command == "get-repository":
        assert isinstance(scm, GetRepositoryProtocol)
        dump(scm.get_repository())

    elif args.command == "list-repositories":
        assert isinstance(scm, ListRepositoriesProtocol)
        dump(scm.list_repositories())

    elif args.command == "get-repository-assignees":
        assert isinstance(scm, GetRepositoryAssigneesProtocol)
        dump(scm.get_repository_assignees())

    elif args.command == "list-repository-user-permissions":
        assert isinstance(scm, ListRepositoryUserPermissionsProtocol)
        dump(scm.list_repository_user_permissions())

    elif args.command == "get-repository-user-permission":
        assert isinstance(scm, GetRepositoryUserPermissionProtocol)
        dump(scm.get_repository_user_permission(args.username))

    elif args.command == "get-repository-labels":
        assert isinstance(scm, GetRepositoryLabelsProtocol)
        dump(scm.get_repository_labels())

    elif args.command == "get-repository-topics":
        assert isinstance(scm, GetRepositoryTopicsProtocol)
        dump(scm.get_repository_topics())

    elif args.command == "get-app-installation":
        assert isinstance(scm, GetAppInstallationProtocol)
        dump(scm.get_app_installation())

    elif args.command == "get-authenticated-actor":
        assert isinstance(scm, GetAuthenticatedActorProtocol)
        dump(scm.get_authenticated_actor())


if __name__ == "__main__":
    logging.basicConfig(level=logging.DEBUG)
    main()
