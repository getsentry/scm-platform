#!/usr/bin/env python
import argparse
import logging
import sys

from scm.manager import SourceCodeManager
from scm.private.cli_support import add_commands, execute_command, load_credentials, resolve


def main():
    creds = load_credentials()

    parser = argparse.ArgumentParser(description="RPC client for Sentry, for GitHub repositories")

    parser.add_argument(
        "--base-url",
        default="http://localhost:8000",
        help="URL where Sentry is accessible",
    )
    parser.add_argument(
        "--secret",
        default=None,
        help=(
            "RPC shared secret (value of Sentry's SCM_RPC_SHARED_SECRET setting)."
            " Defaults to SCM_RPC_SECRET from .credentials"
        ),
    )

    parser.add_argument("--org-id", type=int, default=1, help="Sentry organization ID owning the repository")
    parser.add_argument(
        "--repo",
        default=creds.get("GITHUB_REPOSITORY_ID"),
        required="GITHUB_REPOSITORY_ID" not in creds,
        help=(
            "GitHub repository id, found in https://api.github.com/repos/{owner}/{repo}."
            "Defaults to GITHUB_REPOSITORY_ID from .credentials"
        ),
    )

    add_commands(parser)

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        sys.exit(1)

    secret = resolve("SCM_RPC_SECRET", args.secret, creds)

    scm = SourceCodeManager.make_proxy_client(
        args.org_id,
        ("github", args.repo),
        base_url=args.base_url,
        signing_secret=secret,
    )

    execute_command(args, scm)


if __name__ == "__main__":
    logging.basicConfig(level=logging.DEBUG)
    main()
