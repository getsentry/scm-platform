#!/usr/bin/env python
"""
RPC client that talks to a bitbucket-server instance.

Usage:
    bin/bitbucket-client --repo <workspace>/<repo_slug> <command> [args...]

Configuration (CLI args override env vars):
    --base-url / SCM_RPC_BASE_URL       Server URL (default: http://127.0.0.1:8080)
    --secret / SCM_RPC_SIGNING_SECRET   HMAC signing secret (default: "secret")
    --org-id                            Organization ID (default: 1)
    --repo / BITBUCKET_REPO             Bitbucket repository as <workspace>/<repo_slug>

Commands:
    get-repository
    get-app-installation
    get-git-commit <sha>
    get-tree <tree_sha> [--non-recursive] [--cursor <cursor>] [--per-page <n>]
    get-full-tree <tree_sha> [--non-recursive]
"""

import argparse
import json
import logging
import pathlib
import sys

from scm import Secret
from scm.manager import SourceCodeManager
from scm.types import (
    GetAppInstallationProtocol,
    GetFullTreeProtocol,
    GetGitCommitProtocol,
    GetRepositoryProtocol,
    GetTreeProtocol,
    PaginationParams,
)

logger = logging.getLogger(__name__)


def dump(obj):
    logger.info(json.dumps(obj, indent=2, default=str))


def load_credentials() -> dict[str, str]:
    """Load KEY=VALUE pairs from .credentials, skipping blanks and comments."""
    creds: dict[str, str] = {}
    path = pathlib.Path(__file__).resolve().parent.parent / ".credentials"
    if not path.exists():
        return creds
    for line in path.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        value = value.strip()
        if value:
            creds[key.strip()] = value
    return creds


def main():
    creds = load_credentials()

    parser = argparse.ArgumentParser(description="Bitbucket RPC Client")
    parser.add_argument("--base-url", default=None)
    parser.add_argument("--secret", default=None)
    parser.add_argument("--org-id", type=int, default=1)
    parser.add_argument(
        "--repo",
        default=creds.get("BITBUCKET_REPO"),
        required="BITBUCKET_REPO" not in creds,
        help="<workspace>/<repo_slug>; defaults to BITBUCKET_REPO from .credentials",
    )

    sub = parser.add_subparsers(dest="command")
    sub.add_parser("get-repository")
    sub.add_parser("get-app-installation")

    p = sub.add_parser("get-git-commit")
    p.add_argument("sha")

    p = sub.add_parser("get-tree")
    p.add_argument("tree_sha")
    p.add_argument("--non-recursive", action="store_true")
    p.add_argument("--cursor", default=None)
    p.add_argument("--per-page", type=int, default=None)

    p = sub.add_parser("get-full-tree")
    p.add_argument("tree_sha")
    p.add_argument("--non-recursive", action="store_true")

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        sys.exit(1)

    kwargs = {
        "base_url": args.base_url if args.base_url else "http://127.0.0.1:8080",
        "signing_secret": Secret(args.secret if args.secret else "secret"),
    }

    scm = SourceCodeManager.make_proxy_client(
        args.org_id,
        ("bitbucket", args.repo),
        **kwargs,
    )

    if args.command == "get-repository":
        assert isinstance(scm, GetRepositoryProtocol)
        dump(scm.get_repository())

    elif args.command == "get-app-installation":
        assert isinstance(scm, GetAppInstallationProtocol)
        dump(scm.get_app_installation())

    elif args.command == "get-git-commit":
        assert isinstance(scm, GetGitCommitProtocol)
        dump(scm.get_git_commit(args.sha))

    elif args.command == "get-tree":
        assert isinstance(scm, GetTreeProtocol)
        pagination: PaginationParams = {}
        if args.cursor is not None:
            pagination["cursor"] = args.cursor
        if args.per_page is not None:
            pagination["per_page"] = args.per_page
        dump(scm.get_tree(args.tree_sha, recursive=not args.non_recursive, pagination=pagination or None))

    elif args.command == "get-full-tree":
        assert isinstance(scm, GetFullTreeProtocol)
        dump(scm.get_full_tree(args.tree_sha, recursive=not args.non_recursive))


if __name__ == "__main__":
    logging.basicConfig(level=logging.DEBUG)
    main()
