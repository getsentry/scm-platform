#!/usr/bin/env python
import argparse
import logging
import sys

from scm.manager import SourceCodeManager
from scm.private.cli_support import add_commands, execute_command, load_credentials, resolve


def main():
    creds = load_credentials()

    parser = argparse.ArgumentParser(description="RPC client for bin/scm-server, for GitLab repositories")

    parser.add_argument(
        "--base-url",
        default="http://localhost:8080",
        help="URL where bin/scm-server is accessible",
    )
    parser.add_argument(
        "--secret",
        default=None,
        help="RPC shared secret. Defaults to SCM_RPC_SECRET from .credentials",
    )

    parser.add_argument("--org-id", type=int, default=1, help="Sentry organization ID owning the repository")
    parser.add_argument(
        "--repo",
        default=creds.get("GITLAB_PROJECT_ID"),
        required="GITLAB_PROJECT_ID" not in creds,
        help=(
            "GitLab project ID (numeric, found in the top-right '...' menu on the GitLab project page)."
            " Defaults to GITLAB_PROJECT_ID from .credentials"
        ),
    )

    add_commands(parser)

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        sys.exit(1)

    secret = resolve("SCM_RPC_SECRET", args.secret, creds)

    scm = SourceCodeManager.make_proxy_client(
        args.org_id,
        ("gitlab", args.repo),
        base_url=args.base_url,
        signing_secret=secret,
    )

    execute_command(args, scm)


if __name__ == "__main__":
    logging.basicConfig(level=logging.DEBUG)
    main()
