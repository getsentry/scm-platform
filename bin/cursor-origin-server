#!/usr/bin/env python
"""
Standalone RPC server that proxies requests to the real Cursor Origin API
using Origin App installation authentication.

Usage:
    bin/cursor-origin-server                      # reads from .credentials
    bin/cursor-origin-server --app-id app_... ... # CLI overrides

Credentials are loaded from .credentials (KEY=VALUE, one per line) then
overridden by env vars, then by CLI args.

Configuration:
    --app-id / ORIGIN_APP_ID                  Origin App id, e.g. app_01... (required)
    --private-key / ORIGIN_PRIVATE_KEY_PATH   Path to the app's Ed25519 .pem (required)
    --installation-id / ORIGIN_INSTALLATION_ID
                                              Installation id, e.g. i_01...
                                              (optional; discovered from
                                               GET /app/installations when omitted)
    --secret / SCM_RPC_SIGNING_SECRET         HMAC signing secret (default: "secret")
    --host                                    Bind address (default: 127.0.0.1)
    --port                                    Listen port (default: 8081)
    --base-url / ORIGIN_BASE_URL              API base URL
                                              (default: https://api.cursor.com/v1/origin)
    --web-base-url / ORIGIN_WEB_BASE_URL      Web UI base used to build links
                                              (default: https://cursor.com)

Auth differs from the GitHub server in two ways worth knowing before you debug it:

  * The app JWT is **EdDSA over Ed25519**, not RS256, and PyJWT needs a key *object*
    rather than the PEM string -- hence `load_pem_private_key`. It also requires
    `aud: origin-apps` and a `kid` header carrying the app id.
  * Installation tokens live **under 15 minutes**, far shorter than GitHub's hour, so
    the refresh window here is minutes rather than tens of minutes.
"""

import argparse
import json
import logging
import os
import pathlib
import sys
import time
from http.server import BaseHTTPRequestHandler, HTTPServer
from typing import Any

import jwt
import requests
from cryptography.hazmat.primitives import serialization
from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey

from scm.providers.cursor_origin.provider import CURSOR_ORIGIN_WEB_BASE_URL, CursorOriginProvider
from scm.rpc.server import RpcServer
from scm.types import CredentialsSet, Provider, Repository, RepositoryId

logger = logging.getLogger(__name__)

ORIGIN_API_BASE = "https://api.cursor.com/v1/origin"

# Origin installation tokens expire in under 15 minutes; refresh well before that.
TOKEN_LIFETIME_MARGIN_SECONDS = 300
JWT_LIFETIME_SECONDS = 240


class InstallationTokenManager:
    """Mints Origin app JWTs and installation access tokens, refreshing as needed."""

    def __init__(
        self,
        app_id: str,
        private_key: Ed25519PrivateKey,
        installation_id: str | None = None,
        base_url: str = ORIGIN_API_BASE,
    ) -> None:
        self.app_id = app_id
        self.private_key = private_key
        self.base_url = base_url
        self._installation_id = installation_id
        self._token: str | None = None
        self._expires_at: float = 0

    def _make_jwt(self) -> str:
        now = int(time.time())
        return jwt.encode(
            {
                "iss": self.app_id,
                "aud": "origin-apps",
                "iat": now - 30,
                "exp": now + JWT_LIFETIME_SECONDS,
            },
            self.private_key,
            algorithm="EdDSA",
            headers={"kid": self.app_id},
        )

    def _discover_installation_id(self) -> str:
        response = requests.get(
            f"{self.base_url}/app/installations",
            headers={"Authorization": f"Bearer {self.application_token}"},
            timeout=30,
        )
        response.raise_for_status()
        payload = response.json()
        installations = payload.get("installations") or []
        if not installations:
            raise SystemExit("The app has no installations. Install it on a codebase first.")
        if len(installations) > 1:
            logger.warning(
                "App has %d installations; using the first. Set ORIGIN_INSTALLATION_ID to pin one.", len(installations)
            )
        return installations[0]["id"]

    @property
    def installation_id(self) -> str:
        if self._installation_id is None:
            self._installation_id = self._discover_installation_id()
            logger.info("Discovered installation %s", self._installation_id)
        return self._installation_id

    def _refresh(self) -> None:
        response = requests.post(
            f"{self.base_url}/app/installations/{self.installation_id}/access_tokens",
            headers={"Authorization": f"Bearer {self.application_token}"},
            timeout=30,
        )
        response.raise_for_status()
        self._token = response.json()["token"]
        self._expires_at = time.time() + TOKEN_LIFETIME_MARGIN_SECONDS

    @property
    def application_token(self) -> str:
        """A JWT for the app itself; required by every /app endpoint."""
        return self._make_jwt()

    @property
    def installation_token(self) -> str:
        """A valid `oit_` token for the installation, refreshed when close to expiry."""
        if self._token is None or time.time() >= self._expires_at:
            self._refresh()
        assert self._token is not None
        return self._token


class CursorOriginApiClient:
    """API client that makes authenticated HTTP requests to the Origin API."""

    def __init__(self, token_manager: InstallationTokenManager, base_url: str = ORIGIN_API_BASE) -> None:
        self.token_manager = token_manager
        self.base_url = base_url

    def request(
        self,
        method: str,
        path: str,
        headers: dict[str, str] | None = None,
        data: dict[str, Any] | None = None,
        params: dict[str, str] | None = None,
        allow_redirects: bool | None = None,
        stream: bool = True,
        raw_response: bool = True,
        credentials_set: CredentialsSet = "installation",
        timeout: float | tuple[float, float] | None = None,
    ) -> requests.Response:
        token = (
            self.token_manager.installation_token
            if credentials_set == "installation"
            else self.token_manager.application_token
        )
        req_headers = {"Authorization": f"Bearer {token}", "Accept": "application/json"}
        if headers:
            req_headers.update(headers)

        kwargs: dict[str, Any] = {"headers": req_headers, "stream": stream}
        if data is not None:
            kwargs["json"] = data
        if params is not None:
            kwargs["params"] = params
        if allow_redirects is not None:
            kwargs["allow_redirects"] = allow_redirects

        return requests.request(method, f"{self.base_url}{path}", **kwargs)


def make_fetch_repository(web_base_url: str):
    def _fetch_repository(organization_id: int, repository_id: RepositoryId) -> Repository | None:
        if isinstance(repository_id, (list, tuple)):
            _, external_id = repository_id
            return {
                "id": 1,
                "external_id": external_id,
                "integration_id": 1,
                "is_active": True,
                # Origin paths are keyed by fullName ("ownerSlug/repoName").
                "name": external_id,
                "organization_id": organization_id,
                "provider_name": "cursor_origin",
                "web_base_url": web_base_url,
            }
        return None

    return _fetch_repository


def make_fetch_provider(token_manager: InstallationTokenManager):
    def fetch_provider(organization_id: int, repository: Repository) -> Provider | None:
        client = CursorOriginApiClient(token_manager, base_url=token_manager.base_url)
        return CursorOriginProvider(
            client=client,
            organization_id=organization_id,
            repository=repository,
            web_base_url=repository.get("web_base_url") or CURSOR_ORIGIN_WEB_BASE_URL,
        )

    return fetch_provider


class RpcHandler(BaseHTTPRequestHandler):
    server: "RpcHTTPServer"

    def do_GET(self):
        headers = dict(self.headers.items())
        response = self.server.rpc.get(headers)
        self.send_response(response.status_code)
        for k, v in response.headers.items():
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(response.content)

    def do_POST(self):
        content_length = int(self.headers.get("Content-Length", 0))
        data = self.rfile.read(content_length)
        headers = dict(self.headers.items())

        try:
            response = self.server.rpc.post(data, headers)
        except Exception as exc:
            body = json.dumps({"errors": [{"detail": str(exc)}]}).encode()
            self.send_response(502)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(body)
            return

        self.send_response(response.status_code)
        for k, v in response.headers.items():
            self.send_header(k, v)
        self.end_headers()
        for chunk in response.content:
            self.wfile.write(chunk)

    def log_message(self, format, *args):
        sys.stderr.write(f"[{self.log_date_time_string()}] {format % args}\n")


class RpcHTTPServer(HTTPServer):
    def __init__(self, server_address, handler_class, rpc: RpcServer) -> None:
        self.rpc = rpc
        super().__init__(server_address, handler_class)


def load_credentials() -> dict[str, str]:
    """Load KEY=VALUE pairs from .credentials, skipping blanks and comments."""
    creds: dict[str, str] = {}
    path = pathlib.Path(__file__).resolve().parent.parent / ".credentials"
    if not path.exists():
        return creds
    for line in path.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        value = value.strip().strip("\"'")
        if value:
            creds[key.strip()] = value
    return creds


def resolve(key: str, cli_value: str | None, creds: dict[str, str]) -> str | None:
    """CLI arg wins, then env var, then .credentials file."""
    return cli_value or os.environ.get(key) or creds.get(key)


def load_ed25519_key(path: str) -> Ed25519PrivateKey:
    key = serialization.load_pem_private_key(pathlib.Path(path).expanduser().read_bytes(), password=None)
    if not isinstance(key, Ed25519PrivateKey):
        raise SystemExit(f"Expected an Ed25519 private key at {path}, got {type(key).__name__}.")
    return key


def main():
    parser = argparse.ArgumentParser(description="Cursor Origin RPC Server (App Installation Auth)")
    parser.add_argument("--app-id", default=None)
    parser.add_argument("--private-key", default=None)
    parser.add_argument("--installation-id", default=None)
    parser.add_argument("--secret", default=None)
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", type=int, default=8081)
    parser.add_argument("--base-url", default=None)
    parser.add_argument("--web-base-url", default=None)
    args = parser.parse_args()

    creds = load_credentials()

    app_id = resolve("ORIGIN_APP_ID", args.app_id, creds)
    private_key_path = resolve("ORIGIN_PRIVATE_KEY_PATH", args.private_key, creds)
    installation_id = resolve("ORIGIN_INSTALLATION_ID", args.installation_id, creds)
    secret = resolve("SCM_RPC_SIGNING_SECRET", args.secret, creds) or "secret"
    base_url = resolve("ORIGIN_BASE_URL", args.base_url, creds) or ORIGIN_API_BASE
    web_base_url = resolve("ORIGIN_WEB_BASE_URL", args.web_base_url, creds) or CURSOR_ORIGIN_WEB_BASE_URL

    missing = [
        name for name, value in (("ORIGIN_APP_ID", app_id), ("ORIGIN_PRIVATE_KEY_PATH", private_key_path)) if not value
    ]
    if missing:
        logger.error(f"Error: missing required config: {', '.join(missing)}")
        sys.exit(1)

    assert app_id is not None and private_key_path is not None
    token_manager = InstallationTokenManager(
        app_id,
        load_ed25519_key(private_key_path),
        installation_id,
        base_url=base_url,
    )

    rpc = RpcServer(
        secrets=[secret],
        fetch_repository=make_fetch_repository(web_base_url=web_base_url),
        fetch_provider=make_fetch_provider(token_manager),
        record_count=lambda name, value, tags: None,
        emit_error=lambda e: logger.error(e),
    )

    server = RpcHTTPServer((args.host, args.port), RpcHandler, rpc)
    logger.info(f"Listening on {args.host}:{args.port}")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        logger.info("\nShutting down.")
        server.server_close()


if __name__ == "__main__":
    logging.basicConfig(level=logging.DEBUG)
    main()
