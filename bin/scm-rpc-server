#!/usr/bin/env python
import argparse
import json
import logging
import sys
from http.server import BaseHTTPRequestHandler, HTTPServer
from urllib.parse import urlparse

from scm.private.cli_support import (
    GitHubApiClient,
    GitHubInstallationTokenManager,
    GitLabApiClient,
    load_credentials,
    resolve,
)
from scm.providers.github.provider import GitHubProvider
from scm.providers.gitlab.provider import GitLabProvider
from scm.rpc.client import NoOpRateLimitProvider
from scm.rpc.server import RpcServer
from scm.types import Provider, Repository, RepositoryId

logger = logging.getLogger(__name__)


def make_fetch_repository(gitlab_base_url: str):
    netloc = urlparse(gitlab_base_url).netloc

    def fetch_repository(organization_id: int, repository_id: RepositoryId) -> Repository | None:
        if isinstance(repository_id, (list, tuple)):
            provider_name, external_id = repository_id
            if provider_name == "gitlab":
                external_id = f"{netloc}:{external_id}"
            return {
                "id": 1,
                "external_id": external_id,
                "integration_id": 1,
                "is_active": True,
                "name": external_id,
                "organization_id": organization_id,
                "provider_name": provider_name,
            }
        return None

    return fetch_repository


def make_fetch_provider(github_client: GitHubApiClient, gitlab_client: GitLabApiClient):
    def fetch_provider(organization_id: int, repository: Repository) -> Provider | None:
        if repository["provider_name"] == "github":
            return GitHubProvider(
                client=github_client,
                organization_id=organization_id,
                repository=repository,
                rate_limit_provider=NoOpRateLimitProvider(),
            )
        elif repository["provider_name"] == "gitlab":
            return GitLabProvider(
                client=gitlab_client,
                organization_id=organization_id,
                repository=repository,
            )
        else:
            raise AssertionError(f"Unsupported provider: {repository['provider_name']}")

    return fetch_provider


class RpcHandler(BaseHTTPRequestHandler):
    server: "RpcHTTPServer"

    def do_GET(self):
        headers = dict(self.headers.items())
        response = self.server.rpc.get(headers)
        self.send_response(response.status_code)
        for k, v in response.headers.items():
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(response.content)

    def do_POST(self):
        content_length = int(self.headers.get("Content-Length", 0))
        data = self.rfile.read(content_length)
        headers = dict(self.headers.items())

        try:
            response = self.server.rpc.post(data, headers)
        except Exception as exc:
            body = json.dumps({"errors": [{"detail": str(exc)}]}).encode()
            self.send_response(502)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(body)
            return

        self.send_response(response.status_code)
        for k, v in response.headers.items():
            self.send_header(k, v)
        self.end_headers()
        for chunk in response.content:
            self.wfile.write(chunk)

    def log_message(self, format, *args):
        sys.stderr.write(f"[{self.log_date_time_string()}] {format % args}\n")


class RpcHTTPServer(HTTPServer):
    def __init__(self, server_address, handler_class, rpc: RpcServer) -> None:
        self.rpc = rpc
        super().__init__(server_address, handler_class)


def main():
    parser = argparse.ArgumentParser(description="GitLab RPC Server (Access Token Auth)")

    parser.add_argument(
        "--github-app-id",
        default=None,
        help="GitHub App ID. Defaults to GITHUB_APP_ID from .credentials",
    )
    parser.add_argument(
        "--github-private-key",
        default=None,
        help="Path to the GitHub App private key. Defaults to GITHUB_PRIVATE_KEY_PATH from .credentials",
    )
    parser.add_argument(
        "--github-installation-id",
        default=None,
        help="GitHub App installation ID. Defaults to GITHUB_INSTALLATION_ID from .credentials",
    )

    parser.add_argument(
        "--gitlab-base-url",
        default=None,
        help="Base URL for the GitLab instance. Defaults to GITLAB_BASE_URL from .credentials",
    )
    parser.add_argument(
        "--gitlab-access-token",
        default=None,
        help="GitLab access token. Defaults to GITLAB_ACCESS_TOKEN from .credentials",
    )

    parser.add_argument(
        "--secret", default=None, help="RPC shared secret. Defaults to SCM_RPC_SECRET from .credentials"
    )
    parser.add_argument("--host", default="127.0.0.1", help="Host/IP to listen on")
    parser.add_argument("--port", type=int, default=8080, help="Port to listen on")

    args = parser.parse_args()

    creds = load_credentials()

    github_app_id = resolve("GITHUB_APP_ID", args.github_app_id, creds)
    github_private_key_path = resolve("GITHUB_PRIVATE_KEY_PATH", args.github_private_key, creds)
    github_installation_id = resolve("GITHUB_INSTALLATION_ID", args.github_installation_id, creds)
    gitlab_base_url = resolve("GITLAB_BASE_URL", args.gitlab_base_url, creds)
    gitlab_access_token = resolve("GITLAB_ACCESS_TOKEN", args.gitlab_access_token, creds)
    secret = resolve("SCM_RPC_SECRET", args.secret, creds)

    missing = []
    if not github_app_id:
        missing.append("GITHUB_APP_ID")
    if not github_private_key_path:
        missing.append("GITHUB_PRIVATE_KEY_PATH")
    if not github_installation_id:
        missing.append("GITHUB_INSTALLATION_ID")
    if not gitlab_access_token:
        missing.append("GITLAB_ACCESS_TOKEN")
    if not gitlab_base_url:
        missing.append("GITLAB_BASE_URL")
    if not secret:
        missing.append("SCM_RPC_SECRET")
    if missing:
        logger.error(f"Error: missing required config: {', '.join(missing)}")
        sys.exit(1)

    with open(github_private_key_path) as f:
        github_private_key = f.read()

    github_client = GitHubApiClient(
        GitHubInstallationTokenManager(github_app_id, github_private_key, github_installation_id)
    )
    gitlab_client = GitLabApiClient(gitlab_base_url, gitlab_access_token)

    rpc = RpcServer(
        secrets=[secret],
        fetch_repository=make_fetch_repository(gitlab_base_url),
        fetch_provider=make_fetch_provider(github_client, gitlab_client),
        record_count=lambda name, value, tags: None,
        emit_error=lambda e: logger.exception(e),
    )

    server = RpcHTTPServer((args.host, args.port), RpcHandler, rpc)
    logger.debug(f"Listening on {args.host}:{args.port}")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        logger.debug("\nShutting down.")
        server.server_close()


if __name__ == "__main__":
    logging.basicConfig(level=logging.DEBUG)
    main()
